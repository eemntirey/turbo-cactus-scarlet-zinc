{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hepta",
  "version": "0.1.0",
  "identifier": "com.hepta.calendar",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:8080",
    "frontendDist": "./boot"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hepta",
        "width": 420,
        "height": 820,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "Utility",
    "shortDescription": "Calendrier de 25 heures",
    "longDescription": "Hepta — calendrier de 25 heures, sept jours, sept semaines et sept mois.",
    "copyright": "Hepta",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    },
    "android": {
      "minSdkVersion": 24,
      "versionCode": 1000000
    }
  }
}
